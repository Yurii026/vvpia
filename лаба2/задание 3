#include <iostream>
#include <iomanip>
#include <cmath>
#include <limits>
#include <string>

// ---------- Функция безопасного ввода вещественного числа ----------
bool readDouble(const std::string& prompt, double& value) {  // параметры: подсказка и ссылка на переменную
    while (true) {   // бесконечный цикл до корректного ввода
        std::cout << prompt;   // печатаем подсказку
        std::cin >> value;   // читаем число
        if (std::cin.fail()) { // если ввод провалился (например, ввели "abc")
            std::cin.clear();   // сбрасываем флаг ошибки
            std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n'); // чистим буфер до перевода строки
            std::cout << "Ошибка: введите корректное число!\n"; // сообщаем об ошибке
            continue; // возвращаемся к началу цикла
        }
        return true;  // ввод корректен — выходим из функции
    }
}

// Функция безопасного ввода целого неотрицательного числа
bool readInt(const std::string& prompt, int& value) {             // параметры: подсказка и ссылка на int
    while (true) {                                                // цикл до корректного ввода
        std::cout << prompt;                                      // печатаем подсказку
        std::cin >> value;                                        // читаем целое число
        if (std::cin.fail() || value < 0) {                       // ошибка ввода или отрицательное значение
            std::cin.clear();                                     // сбрасываем флаг ошибки
            std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n'); // чистим буфер
            std::cout << "Ошибка: введите целое неотрицательное число!\n"; // сообщаем
            continue;                                             // повторяем
        }
        return true;                                              // успех
    }
}

int main() {  // главная функция
    setlocale(LC_ALL, "ru"); // русская локаль

    std::cout << "  СЛОЖНЫЕ ПРОЦЕНТЫ\n"; // заголовок

    double principal; // начальный вклад (double — может быть 1000.50)
    double rate;  // годовая ставка в % (double — 7.5 и т. п.)
    int    years; // количество лет (int — целое)

    readDouble("Введите начальный вклад (P): ", principal); // безопасный ввод P
    readDouble("Введите годовую ставку в % (r): ", rate); // безопасный ввод r
    readInt("Введите количество лет (n): ", years); // безопасный ввод n

    // Граничный случай
    if (principal <= 0) {                                        //


        // если вклад 0 или отрицательный
        std::cout << "Предупреждение: вклад должен быть > 0. Установлено 1.0\n"; // сообщаем
        principal = 1.0;                                         // корректируем значение
    }

    // Расчёт в double (точный)
    double factor = 1.0 + static_cast<double>(rate) / 100.0;  // множитель (1 + r/100), явный double
    double resultDouble = principal * std::pow(factor, years); // S = P * factor^n (double)

    // Расчёт во float (для сравнения точности) 
    float principalF = static_cast<float>(principal);    // P -> float
    float rateF = static_cast<float>(rate);    // r -> float
    float factorF = 1.0f + rateF / 100.0f;   // множитель во float (суффикс f)
    float resultFloat = principalF * std::pow(factorF, static_cast<float>(years)); // S во float

    //Вывод результата расчёта
    std::cout << std::fixed << std::setprecision(6); // 6 знаков после запятой
    std::cout << "\n--- Результат расчёта ---\n"; // подзаголовок
    std::cout << "Начальный вклад:  " << principal << " руб.\n"; // выводим P
    std::cout << "Ставка:           " << rate << " %\n";  // выводим r
    std::cout << "Лет:              " << years << "\n";  // выводим n
    std::cout << "Итог (double):    " << resultDouble << " руб.\n"; // результат double
    std::cout << "Итог (float):     " << resultFloat  << " руб.\n"; // результат float
    std::cout << "Разница:          " << std::fabs(resultDouble - static_cast<double>(resultFloat)) // модуль разности
    << " руб.\n"; // конец строки

    //Накопление погрешности (1000 итераций)
    std::cout << "\n--- Накопление погрешности (1000 итераций по +0.1) ---\n"; // подзаголовок
    float  accF = 0.0f;  // накопитель float (обнуляем)
    double accD = 0.0;// накопитель double (обнуляем)

    for (int i = 0; i < 1000; ++i) {   // цикл на 1000 повторений
        accF += 0.1f;  // прибавляем 0.1 к float-накопителю
        accD += 0.1;  // прибавляем 0.1 к double-накопителю
    }

    std::cout << std::setprecision(10);  // 10 знаков — чтобы увидеть разницу
    std::cout << "Ожидаемое значение:  100.0\n"; // напоминаем эталон
    std::cout << "float  после 1000:   " << accF << "\n"; // вывод float-накопителя
    std::cout << "double после 1000:   " << accD << "\n";  // вывод double-накопителя
    std::cout << "Погрешность float:   " // подпись
        << std::fabs(100.0 - static_cast<double>(accF)) << "\n"; // |100 - accF|
    std::cout << "Погрешность double:  " // подпись
        << std::fabs(100.0 - accD) << "\n"; // |100 - accD|

    // Усечение vs округление 
    std::cout << "\n--- Усечение (truncation) vs Округление (rounding) ---\n"; // подзаголовок
    std::cout << std::setprecision(4);   // 4 знака после запятой
    double values[] = { 3.1, 3.5, 3.9, -3.1, -3.5, -3.9 }; // массив тестовых значений

    std::cout << std::setw(8)  << "Знач."  // заголовок столбца 1, ширина 8
        << std::setw(14) << "Усечение" // заголовок столбца 2, ширина 14
        << std::setw(16) << "Округление" << "\n"; // заголовок столбца 3, ширина 16

    for (double v : values) { // перебираем все значения массива
    int truncated = static_cast<int>(v);  // усечение: просто отбрасываем дробную часть
    int rounded = static_cast<int>(std::round(v));  // округление: до ближайшего целого

    std::cout << std::setw(8)  << v                          // выводим исходное значение
    << std::setw(14) << truncated                  // выводим усечённое
    << std::setw(16) << rounded << "\n";           // выводим округлённое
    }

    // Граничные значения типов
    std::cout << "\n--- Граничные значения ---\n"; // подзаголовок
    std::cout<< "INT_MAX = " << std::numeric_limits<int>::max() << "\n"; // максимум int (2147483647)
    std::cout << "INT_MIN = " << std::numeric_limits<int>::min() << "\n"; // минимум int (-2147483648)
    std::cout << "float  eps = " << std::numeric_limits<float>::epsilon()  << "\n"; // машинный эпсилон float
    std::cout << "double eps = " << std::numeric_limits<double>::epsilon() << "\n"; // машинный эпсилон double

    return 0; // успешное завершение
}
