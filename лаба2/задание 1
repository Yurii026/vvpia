#include <iostream>

int main() {
	setlocale(LC_ALL, "ru");
	// Объявляем переменные типа double
	// Почему double? Температура может быть дробной (например, 36.6 °C) 
		double celsius; // Температура в градусах Цельсия (ввод пользователя) 
		double fahrenheit; // Температура в градусах Фаренгейта (результат) 
		std::cout << "Введите температуру в градусах цельсия: ";  // Выводим приглашение для пользователя

		std::cin >> celsius; // Считываем значение с клавиатуры в переменную celsius

		fahrenheit = celsius * 9.0 / 5.0 + 32; // Вычисляем по формуле

		std::cout << celsius << " °C = " << fahrenheit << " °F" << std::endl; // Выводим результат с пояснением

		return 0; // Успешное завершение программы
}
