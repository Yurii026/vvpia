#include <iostream>
#include <limits>

int main() {
    setlocale(LC_ALL, "ru");
    int num;

    std::cout << "--- БАЗОВЫЙ УРОВЕНЬ (Проверка кратности 15) ---\n";

    while (true) {
        std::cout << "Введите целое число: ";
        std::cin >> num;

        // Защита от ввода букв и символов
        if (std::cin.fail()) {
            std::cout << "ОШИБКА: Некорректный ввод! Пожалуйста, введите целое число.\n";
            std::cin.clear();
            std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
        }
        else {
            break; // Ввод корректен, выходим из цикла валидации
        }
    }

    // Число кратно 15 тогда и только тогда, когда оно одновременно делится на 3 и на 5
    if (num % 3 == 0 && num % 5 == 0) {
        std::cout << "Результат: Кратно 15\n";
    }
    else {
        std::cout << "Результат: Не кратно 15\n";
    }

    return 0;
}
